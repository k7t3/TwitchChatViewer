<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane id="prefsRootStackPane" fx:id="root" styleClass="preference-view" stylesheets="@PreferencesView.css"
           xmlns="http://javafx.com/javafx/27" xmlns:fx="http://javafx.com/fxml/1">
    <BorderPane>
        <left>
            <VBox styleClass="prefs-sidebar" prefWidth="212" spacing="16">
                <Label text="%prefs.window.title" styleClass="title-2"/>
                <TreeView fx:id="pagesTreeView" accessibleText="%prefs.categories" showRoot="false" VBox.vgrow="ALWAYS"/>
            </VBox>
        </left>
        <center>
            <VBox styleClass="prefs-workspace" spacing="16">
                <VBox spacing="4">
                    <Label text="%prefs.categories" styleClass="text-muted"/>
                    <Label fx:id="pageHeading" styleClass="title-2"/>
                </VBox>
                <StackPane fx:id="contentPane" styleClass="prefs-content" VBox.vgrow="ALWAYS"/>
            </VBox>
        </center>
        <bottom>
            <ButtonBar fx:id="buttonBar" styleClass="prefs-actions">
                <buttons>
                    <Button fx:id="cancelButton" cancelButton="true" text="%button.cancel"/>
                    <Button fx:id="enterButton" styleClass="accent" text="%prefs.save"/>
                </buttons>
            </ButtonBar>
        </bottom>
    </BorderPane>
</StackPane>
